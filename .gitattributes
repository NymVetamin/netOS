# Правила окончаний строк живут в репозитории, а не в настройке каждой машины.
# Разработка идёт на Windows, а работает netOS на Linux, и без этого файла
# результат зависит от core.autocrlf у того, кто делает коммит.
* text=auto

# Скрипты обязаны быть с LF в любом рабочем дереве. install.sh запускается под
# root на чужой машине, и CRLF там означает «bash: \r: command not found» на
# первой же строке.
*.sh text eol=lf

# Метка пустого каталога для go:embed. Никакого содержимого — значит, никаких
# переводов строк и никакой разницы между Windows и Linux: именно на ней падала
# проверка «сборка не загрязнила репозиторий».
backend/internal/api/webdist/.gitkeep -text
