# Сборка фронтенда — встраивается в бинарник, в репозитории не нужна
/backend/internal/api/webdist/*
!/backend/internal/api/webdist/.gitkeep

# Go
/backend/netosd
*.exe
*.test
*.out
*_tests_linux
*_coverage
*_cov
coverage_full
*.cov

# Node
/web/node_modules/
/web/dist/
npm-debug.log*
.npm/

# Воспроизводимые QA-артефакты и кэши
/output/
audit_*.md
/NETOS_FULL_AUDIT.md
/NETOS_QA_REPORT.md
/.netos-audit/
__pycache__/
*.pyc

# Локальные и временные файлы
*.swp
*.tmp
*~
.DS_Store
.idea/
.vscode/

# Ничего, что содержит секреты, в репозиторий попадать не должно
*.key
*.crt
*.pem
initial-credentials
netos.db
netos.db-*
*.txt
