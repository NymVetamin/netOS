# Сборка фронтенда — встраивается в бинарник, в репозитории не нужна
/backend/internal/api/webdist/*
!/backend/internal/api/webdist/.gitkeep

# Go
/backend/netosd
/backend/netosd-linux-*
/dist/
*.exe
*.test
*.out
*_tests_linux
*_coverage
*_cov
coverage_full
*.cov

# Node
/web/node_modules/
/web/dist/
npm-debug.log*
.npm/

# Кэши Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Локальные и временные файлы
*.swp
*.tmp
*~
.DS_Store
.idea/
.vscode/
*.log
*.tsbuildinfo

# Локальные настройки агентов и артефакты экспериментальных QA-прогонов
/.claude/
/scripts/router-lab/
/docs/testing/
/CLAUDE_TEST_*.md
.playwright-cli/
playwright-report/
test-results/

# Ничего, что содержит секреты, в репозиторий попадать не должно
*.key
*.crt
*.pem
.env
.env.*
!.env.example
initial-credentials
netos.db
netos.db-*
*.txt
*.api
/openrc.sh
